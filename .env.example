# FIFA WC 2026 Model — environment variables
# Copy this file to .env and fill in values.
# The pipeline runs fully offline without any of these.

# Optional: API key for live FIFA rankings (not currently used)
# FIFA_API_KEY=

# Optional: API key for Elo ratings source (not currently used)
# ELO_API_KEY=

# Logging level (DEBUG, INFO, WARNING)
# LOG_LEVEL=INFO
